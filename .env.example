# ---------------------------------------------------------------- core (required)
APP_URL=http://localhost:3000
# Postgres connection. The role must own the schema (migrations) and have CREATEROLE the first time,
# because migrations create the restricted cw_app / cw_service roles used for row-level security.
DATABASE_URL=postgres://clientwrap:clientwrap@localhost:5432/clientwrap_dev
# Optional: separate URL for migrations (e.g. Supabase direct connection vs pooled).
DATABASE_MIGRATION_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# 32+ random chars; signs portal/pay/unsubscribe links.  openssl rand -base64 48
APP_SECRET=
# 32 bytes, base64 or hex; AES-256-GCM key for secrets at rest.  openssl rand -base64 32
ENCRYPTION_KEY=
# Bearer secret for /api/cron (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=
# Comma-separated emails that can open /admin (support dashboard).
ADMIN_EMAILS=reviewer+admin@clientwrap.app
SUPPORT_EMAIL=support@clientwrap.app

# ---------------------------------------------------------------- email (Resend)
# Without a key (dev/test) emails are captured in the DB and shown at /dev/mailbox.
RESEND_API_KEY=
EMAIL_FROM="ClientWrap <hello@clientwrap.app>"

# ---------------------------------------------------------------- Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Stripe (ClientWrap's own subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# ---------------------------------------------------------------- AppSumo Licensing API v2
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=
# Partner API key: used to verify X-Appsumo-Signature on webhooks.
APPSUMO_API_KEY=
APPSUMO_BASE_URL=https://appsumo.com

# ---------------------------------------------------------------- features & integrations
FEATURE_SMS_WHATSAPP=false
SENTRY_DSN=
CUSTOM_DOMAIN_CNAME_TARGET=portal.clientwrap.app
# Optional: attach verified custom domains to the Vercel project automatically.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional in-app chat (Crisp).
CRISP_WEBSITE_ID=

# ---------------------------------------------------------------- seeding & backups
REVIEWER_PASSWORD=Review-ClientWrap-2026
BACKUP_DIR=./backups
BACKUP_S3_URI=
BACKUP_GPG_RECIPIENT=
